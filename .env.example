# ── Client (browser) — safe to expose, anon key only ──────────────────
# If both are set, the app uses the Supabase cloud adapter.
# If unset, the app runs in LocalAdapter mode (seed + direct ATS fetch).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Server-side only — NEVER expose in the client bundle ──────────────
# Used by scripts/sync-ats-jobs.ts, scripts/seed.ts, api/sync.ts (Vercel),
# and Supabase Edge Functions for privileged upserts during sync/moderation.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection (optional). When present, DB/RLS assertion
# tests run in full; otherwise those suites are skipped and the app still
# runs/tests cleanly in LocalAdapter mode.
DATABASE_URL=

# Nominatim geocoding (admin). Descriptive User-Agent is required by OSM.
NOMINATIM_USER_AGENT=Launchpad/1.0 (admin geocoder)
